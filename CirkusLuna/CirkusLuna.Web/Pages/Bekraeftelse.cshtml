@page "{id:int}"
@model BekraeftelseModel
@{
    ViewData["Title"] = "Bekræftelse";
}

@if (Model.Reservation == null)
{
    <div class="alert alert-danger">Reservation ikke fundet.</div>
}
else
{
    <div class="text-center mb-4">
        <h1 class="text-success">Tak for din reservation!</h1>
        <p class="lead">Din booking er nu bekræftet.</p>
    </div>

    <div class="card mx-auto" style="max-width: 600px;">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Reservationsdetaljer</h5>
        </div>
        <div class="card-body">
            <table class="table table-borderless">
                <tr>
                    <th>Reservationsnr.</th>
                    <td>@Model.Reservation.Id</td>
                </tr>
                <tr>
                    <th>Forestilling</th>
                    <td>@Model.Reservation.Forestilling?.Titel</td>
                </tr>
                <tr>
                    <th>Dato</th>
                    <td>@Model.Reservation.Forestilling?.Dato.ToString("d. MMMM yyyy")</td>
                </tr>
                <tr>
                    <th>By</th>
                    <td>@Model.Reservation.Forestilling?.By?.Navn</td>
                </tr>
                <tr>
                    <th>Kunde</th>
                    <td>@Model.Reservation.Kunde?.Navn</td>
                </tr>
                <tr>
                    <th>Billettype</th>
                    <td>@Model.Reservation.Billettype</td>
                </tr>
                <tr>
                    <th>Antal billetter</th>
                    <td>@Model.Reservation.AntalBilletter</td>
                </tr>
                <tr class="table-success">
                    <th>Total pris</th>
                    <td><strong>@Model.Reservation.TotalPris DKK</strong></td>
                </tr>
            </table>
        </div>
        <div class="card-footer text-center">
            <a asp-page="/Program" class="btn btn-primary">Se flere forestillinger</a>
            <a asp-page="/Index" class="btn btn-outline-secondary">Tilbage til forsiden</a>
        </div>
    </div>
}
